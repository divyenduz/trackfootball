{
  "name": "trackfootball",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @trackfootball/rw-app dev",
    "build": "pnpm --filter @trackfootball/* build",
    "start": "pnpm --filter @trackfootball/next-js-app start",
    "test": "pnpm --filter @trackfootball/* test",
    "lint": "pnpm --filter @trackfootball/* lint",
    "release": "pnpm --filter @trackfootball/rw-app release",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "kysely": "catalog:",
    "kysely-postgres-js": "catalog:",
    "postgres": "catalog:"
  }
}
