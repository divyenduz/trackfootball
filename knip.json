{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pg_dump"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{sh,cjs,mjs,js}"],
      "ignoreDependencies": ["prettier", "wrangler"]
    },
    "packages/rw-app": {
      "entry": ["src/client.tsx", "vite.config.mts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["cloudflare", "tailwindcss"],
      "vite": false
    },
    "packages/service": {
      "project": ["**/*.ts"]
    },
    "packages/postgres": {
      "project": ["**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "entry": ["src/bin/bash-completions.ts", "src/commands/completions.ts"]
    },
    "packages/open-api": {
      "entry": ["kubb.config.ts"],
      "project": ["**/*.ts"],
      "ignore": ["services/**/generated/**"]
    }
  }
}
